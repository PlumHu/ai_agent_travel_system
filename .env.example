# ================================================================
# AI Agent 旅行规划系统 — 环境变量配置示例
# 使用方法：复制本文件为 .env，填入真实的 Key 后启动项目
#   cp .env.example .env
# ================================================================


# ================================================================
# LLM 配置（至少填写一个提供商）
# DEFAULT_LLM_PROVIDER 决定自动检测时优先使用哪个
# ================================================================

DEFAULT_LLM_PROVIDER=openai   # 可选: openai | deepseek | nvidia | custom

# ---- OpenAI（或任意 OpenAI 兼容接口）----
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4

# ---- DeepSeek（性价比高，兼容 OpenAI SDK）----
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# DEEPSEEK_MODEL=deepseek-chat

# ---- 英伟达 NIM（免费额度可用）----
# NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxx
# NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# ---- 自定义 OpenAI 兼容接口 ----
# CUSTOM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
# CUSTOM_BASE_URL=https://your-api-endpoint/v1
# CUSTOM_MODEL=your-model-name


# ================================================================
# 工具 API（可选，不填则自动降级到 DuckDuckGo 或 Mock 数据）
# ================================================================

# OpenWeather（天气查询）
# 免费注册：https://openweathermap.org/api
# OPENWEATHER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# 百度地图（路线规划）
# 申请：https://lbsyun.baidu.com/apiconsole/key
# BAIDU_MAPS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# Brave Search（搜索，可选替代 DuckDuckGo）
# 申请：https://api.search.brave.com
# BRAVE_SEARCH_API_KEY=BSAxxxxxxxxxxxxxxxxxxxxxxxx

# Serper（Google 搜索代理，可选）
# 申请：https://serper.dev
# SERPER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx


# ================================================================
# RAG / Embedding 配置
# ================================================================

# Embedding 模型（默认使用本地 HuggingFace 模型，无需 API）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 向量数据库路径（默认 knowledge/vector_db/，无需修改）
# VECTOR_DB_PATH=knowledge/vector_db


# ================================================================
# 系统配置
# ================================================================

# 日志级别：DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Agent 最大迭代次数（防止死循环）
MAX_ITERATIONS=10

# Agent 超时时间（秒）
AGENT_TIMEOUT=300
